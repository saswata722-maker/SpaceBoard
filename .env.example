# NASA API key — get one free at https://api.nasa.gov/
NASA_API_KEY=your_api_key_here

# Solar System OpenData API key (free) — https://api.le-systeme-solaire.net/generatekey.html
# Optional: without it the app serves a built-in planet dataset instead of live data.
SOLAR_SYSTEM_API_KEY=

# Flask settings
FLASK_ENV=development
FLASK_APP=run.py

# Cache settings
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=3600
