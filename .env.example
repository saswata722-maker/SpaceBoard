# Copy this file to `.env` (which is git-ignored) and fill in your own values:
#   cp .env.example .env      # macOS / Linux
#   copy .env.example .env    # Windows
# Leaving a value blank is safe — each one falls back as described below.

# NASA API key — get one free at https://api.nasa.gov/
# Blank or left as the placeholder falls back to NASA's shared DEMO_KEY
# (~30 requests/hour instead of 1,000/hour).
NASA_API_KEY=your_nasa_api_key_here

# Solar System OpenData API key (free)
# https://api.le-systeme-solaire.net/generatekey.html
# Blank: the planets page serves a built-in planet dataset instead of live data.
SOLAR_SYSTEM_API_KEY=

# Flask settings
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-in-production

# Cache settings
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=3600
