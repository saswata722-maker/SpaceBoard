# Copy this file to `.env` (which is git-ignored) and fill in your own values:
#   cp .env.example .env      # macOS / Linux
#   copy .env.example .env    # Windows
# Leaving a value blank is safe — each one falls back as described below.

# NASA API key — get one free at https://api.nasa.gov/
# Blank or left as the placeholder falls back to NASA's shared DEMO_KEY
# (~30 requests/hour instead of 1,000/hour). Set a real key before deploying
# publicly, otherwise the home page and planet data will hit the rate limit fast.
NASA_API_KEY=your_nasa_api_key_here

# Solar System OpenData API key (free, no credit card)
# https://api.le-systeme-solaire.net/generatekey.html — enter your email and the
# key is mailed to you. Blank: the live endpoints return HTTP 401 and the planets
# page and planet detail pages serve the built-in planet dataset with a note
# explaining why. Restart the app after changing this.
SOLAR_SYSTEM_API_KEY=

# Flask settings
# Use "production" when deploying. In development, `python run.py` serves with
# the debugger unless you explicitly set FLASK_DEBUG=1 below.
FLASK_ENV=development
FLASK_APP=run.py

# Set to 1/true to enable the Werkzeug debugger for local development only.
# Never enable this on a public deployment.
FLASK_DEBUG=0

# Secret key used for session signing.
# REQUIRED in production: generate one with
#   python -c "import secrets; print(secrets.token_hex(32))"
# A dev-visible default is used when unset.
SECRET_KEY=change-this-in-production

# Cache settings
# SimpleCache is per-process in-memory and works for a single instance.
# With multiple workers/instances use "FileSystemCache" plus a shared CACHE_DIR
# (or RedisCache) so NASA API rate limits are preserved across processes.
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=3600

# Optional: only needed when CACHE_TYPE=FileSystemCache
# CACHE_DIR=/tmp/spaceboard-cache
